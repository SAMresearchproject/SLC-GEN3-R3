# CR005 declared external inputs
let c = 299792458.0
let earth_mu = 398600441800000.0
let ground_radius = 6378137.0
let orbit_radius = 26560000.0
let nominal_clock = 10230000.0
let seconds_per_day = 86400.0

let packet = EARTH_ORBIT_CLOCK(
    c,
    earth_mu,
    ground_radius,
    orbit_radius,
    nominal_clock,
    seconds_per_day
)

return packet
