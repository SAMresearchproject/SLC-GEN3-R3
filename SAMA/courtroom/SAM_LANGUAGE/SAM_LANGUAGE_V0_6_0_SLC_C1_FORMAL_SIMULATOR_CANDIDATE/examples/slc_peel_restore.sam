let s0: SLCState12 = SLC_ZERO_REGISTER()
let s1: SLCState12 = SLC_PREPARE_REQUEST(s0, L0)
let s2: SLCState12 = SLC_X1_RESPONSE(s1, L0, L1)
let peeled: SLCState12 = SLC_X1_RESPONSE(s2, L0, L1)
let restored: SLCState12 = SLC_X1_RESPONSE(peeled, L0, L1)
let dossier: SLCStateInspection = SLC_INSPECT_STATE(restored)
return dossier

